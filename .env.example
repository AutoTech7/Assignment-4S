# Copy to `.env` to override defaults locally. Real environment variables always win over this file.
# Every variable is optional; see README › Configuration.

# Site under test.
BASE_URL=https://www.fourseasons.com

# Stay search: check-in is TODAY + CHECK_IN_OFFSET_DAYS; if that day is sold out, the next
# AVAILABILITY_SEARCH_DAYS days are tried. NIGHTS is extended only if the hotel enforces a minimum stay.
CHECK_IN_OFFSET_DAYS=30
NIGHTS=1
AVAILABILITY_SEARCH_DAYS=14

# Browser. Defaults: headed locally, headless when CI is set. BROWSER_CHANNEL=chrome uses your installed Chrome.
# HEADLESS=false
# BROWSER_CHANNEL=chrome
# SLOW_MO=0

# Make ad/social pixels and the survey pop-over fail DNS instead of loading (default true).
# BLOCK_THIRD_PARTY=true
